#autogenerated=1

# Env vars

#env = XCURSOR_SIZE,24
#env = HYPRCURSOR_SIZE,24
#env = QT_QPA_PLATFORMTHEME,qt6ct
env = GDK_SCALE,2
env = QT_SCALE_FACTOR,1.5

env = HYPRCURSOR_THEME, Bibata-Modern-Ice
env = HYPRCURSOR_SIZE, 64
env = XCURSOR_THEME,Bibata-Modern-Ice
env = XCURSOR_SIZE,64


#ipc = on
# Monitors

monitor = DP-1, 2560x1440@165, 1920x0, 1
monitor = HDMI-A-1, 1920x1080@100, 0x0, 1 

#primary_monitor = DP-1


$terminal = alacritty
$fileManager = dolphin
$menu = hyprlauncher

# main

general {
    gaps_in = 0
    gaps_out = 0
    border_size = 0
    allow_tearing = false
}


animations {
    enabled = 0
}

misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = true # If true disables the random hyprland logo / anime girl background. :(
focus_on_activate = false


}



# KeyBindings 



###################
### KEYBINDINGS ###
###################

#
$Mod = SUPER # Sets "Windows" key as main modifier

# --------------------Binders-----------------------

bind = $Mod, a, exec, $terminal
bind = meta, Escape, exec, killall hyprland
bind = meta, j, exec, firefox
bind = meta, o, exec, rofi  -show drun
bind = meta, b, exec, ~/Desktop/Beyond-All-Reason-1.2988.0.AppImage
bind = $Mod, w, exec, hyprctl keyword monitor "HDMI-A-1, 1920x1080@100, 0x0, 1, transform, 1"
bind = $Mod, m, exec, hyprctl keyword monitor "HDMI-A-1, 1920x1080@100, 0x0, 1, transform, 0"


bind = $Mod SHIFT, R, exec, hyprctl reload
bind = $Mod, apostrophe, killactive,
#bind = $Mod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $Mod, e, exec, $fileManager
bind = $Mod, space, togglefloating,
bind = $Mod, r, exec, $menu
bind = $Mod, p, pseudo, # dwindle
bind = $Mod, j, togglesplit, # dwindle
bind = $Mod, y, exec, GTK_THEME=Adwaita:dark    transmission-gtk
bind = $Mod, s, exec, steam
bind = $Mod, t, exec, tor-browser


# Move focus with mainMod + arrow keys
bind = $Mod, left, movefocus, l
bind = $Mod, right, movefocus, r
bind = $Mod, up, movefocus, u
bind = $Mod, down, movefocus, d

# Switch workspaces with mainMod + [0-9]
bind = $Mod, 1, workspace, 1
bind = $Mod, 2, workspace, 2
bind = $Mod, 3, workspace, 3
bind = $Mod, 4, workspace, 4
bind = $Mod, 5, workspace, 5
bind = $Mod, 6, workspace, 6
bind = $Mod, 7, workspace, 7
bind = $Mod, 8, workspace, 8
bind = $Mod, 9, workspace, 9
bind = $Mod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $Mod SHIFT, 1, movetoworkspace, 1
bind = $Mod SHIFT, 2, movetoworkspace, 2
bind = $Mod SHIFT, 3, movetoworkspace, 3
bind = $Mod SHIFT, 4, movetoworkspace, 4
bind = $Mod SHIFT, 5, movetoworkspace, 5
bind = $Mod SHIFT, 6, movetoworkspace, 6
bind = $Mod SHIFT, 7, movetoworkspace, 7
bind = $Mod SHIFT, 8, movetoworkspace, 8
bind = $Mod SHIFT, 9, movetoworkspace, 9
bind = $Mod SHIFT, 0, movetoworkspace, 10

bind =  $Mod SHIFT, left,  movewindow, l
bind =  $Mod SHIFT, right, movewindow, r
bind =  $Mod SHIFT, up,    movewindow, u
bind =  $Mod SHIFT, down,  movewindow, d

# Scroll through existing workspaces with mainMod + scroll
bind = $Mod, mouse_down, workspace, e+1
bind = $Mod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $Mod, mouse:272, movewindow
bindm = $Mod, mouse:273, resizewindow
bindel = $Mod SHIFT, s, resizeactive, 60 0 
bindel = $Mod SHIFT, h, resizeactive, -60 0
bindel = $Mod SHIFT, n, resizeactive, 0 -60
bindel = $Mod SHIFT, t, resizeactive, 0 60 

# Laptop multimedia keys for volume and LCD brightness
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

# launch apps

exec-once = waybar
exec-once = hyprpaper
exec-once = ~/.config/scripts/wall.sh 

exec-once = [workspace 2 silent] firefox
exec-once = keyd
exec-once = [workspace 4 silent] GTK_THEME=Adwaita:dark    pavucontrol
exec-once = [workspace 4 silent] dolphin 

# inputs

input {
    kb_layout = us,ru
    kb_options = grp:alt_shift_toggle
    kb_variant = dvorak
    sensitivity = -0.2
    accel_profile = flat 
    follow_mouse = 1
}

cursor {
    warp_on_change_workspace = 0
     no_warps = true  


}
