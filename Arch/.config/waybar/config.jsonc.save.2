
{
    "layer": "top",
    "position": "left",
    "output": ["HDMI-A-1"],
    "width": 35,          // Adjust thickness if needed
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/mode"],  // Use "hyprland/workspaces" if on Hyprland
    "modules-center": ["hyprland/window"],                 // Or "hyprland/window"

    "modules-right": [
	 "network",
	 "pulseaudio", 
         "clock",
	 "tray"
	],

    "hyprland/workspaces": {
        
	"on-click": "activate",
#    	"persistent-workspaces": {
#        	"*": 5
#    },
 
	"disable-scroll": true,
        "all-outputs": true,
	"format": "{name}: {icon}",
	"rotate": 0
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "rotate": 0
    },

    "clock": {
        "format": "{:%H:%M\n%b %d}",
        "rotate": 0,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "wire",
        "format-disconnected": " ",
        "rotate": 0
    },

    "pulseaudio": {
    	"format": "{volume}",
    	"format-bluetooth": "{volume}",
    	"format-muted": "",
    	},

    	"scroll-step": 1,
    	"on-click": "pavucontrol",
    	"ignored-sinks": ["Easy Effects Sink"]
    },


    "tray": {
        "spacing": 10
    }
}
